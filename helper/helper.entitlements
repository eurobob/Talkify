<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The helper loads libopus at runtime, from Homebrew. Under the
	     hardened runtime macOS refuses to load a library signed by anyone
	     else, and the decoder fails with "libraryMissing" while libopus is
	     sitting right there on disk. The hardened runtime is not optional:
	     without it launchd will not run this as a daemon at all. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
